# RouterOS 6/7: pulls approved vouchers from the server every 15 s and creates hotspot users.
# Replace SERVER and ROUTER_KEY (from /var/lib/vicentwifi/secrets.php). RouterOS 6 needs the source on ONE line.
/system script add name=vwifi-pull policy=read,write,policy,test source=":local base \"https://SERVER/wifi-hotspot-admin/api/\"; :local k \"ROUTER_KEY\"; :local go true; :for i from=1 to=5 do={ :if (\$go) do={ :local d \"\"; :do { :local r [/tool fetch url=(\$base . \"router_pull.php\?key=\" . \$k) check-certificate=no output=user as-value]; :set d (\$r->\"data\") } on-error={ :set go false; :log warning \"vwifi: server unreachable\" }; :if ([:len \$d] < 9) do={ :set go false }; :if (\$go) do={ :local a [:toarray \$d]; :local oid [:tostr [:pick \$a 0]]; :local u [:tostr [:pick \$a 1]]; :local p [:tostr [:pick \$a 2]]; :local pr [:tostr [:pick \$a 3]]; :if ([:len [/ip hotspot user find where name=\$u]] = 0) do={ :do { /ip hotspot user add server=all name=\$u password=\$p profile=\$pr comment=(\"vc-\" . \$oid) } on-error={ :log warning (\"vwifi: add failed \" . \$u) } }; :if ([:len [/ip hotspot user find where name=\$u]] > 0) do={ :do { /tool fetch url=(\$base . \"router_ack.php\?key=\" . \$k . \"&id=\" . \$oid) check-certificate=no output=none } on-error={ :log warning \"vwifi: ack failed\" } } else={ :set go false } } } }"
/system scheduler add name=vwifi-pull interval=15s on-event="/system script run vwifi-pull" policy=read,write,policy,test
# Let customers reach the server before they log in:
/ip hotspot walled-garden add dst-host=SERVER action=allow comment=vwifi-api
